[TEMPLATE]
# Modèle OpenRouter utilisé pour les clés enregistrées par les utilisateurs.
# Le routeur et les modèles :free sont gratuits selon les quotas OpenRouter.
OPENROUTER_MODEL=openrouter/free

# Port Express (Render fournit automatiquement PORT en production).
PORT=3001

# Origines autorisées par CORS, séparées par des virgules.
# En production : l'URL Render exacte, par exemple https://nour.onrender.com
CORS_ORIGIN=http://localhost:5173

# URL publique utilisée pour robots.txt et sitemap.xml.
# En local, laisser vide : l'URL de la requête est utilisée.
SITE_URL=

# Base Neon PostgreSQL en production. Laisser vide en local pour SQLite.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Identifiants du compte MAWAQIT (mawaqit.net) pour récupérer les horaires
# officiels des mosquées. Créez un compte gratuit : https://mawaqit.net/fr/register
MAWAQIT_USERNAME=
MAWAQIT_PASSWORD=
